# === Chatbot service (GĐ2) — sao chép thành .env ===

# --- shop_api (chatbot gọi như client public, giống FE web) ---
SHOP_API_BASE_URL=http://127.0.0.1:5000/api/v1

# --- LLM router (OpenAI-compatible). Bỏ trống -> dùng FakeLLM (chạy offline) ---
# Đổi provider = đổi 2 dòng này (adapter §6.3). Production hướng Bedrock/Azure Tokyo (Q7).
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Hạn chờ router, tách theo chỗ gọi (trước dùng chung 20s cho cả hai).
#  - NLU chặn cả lượt chat: hỏng thì khách ngồi đợi hết hạn rồi mới nhận câu
#    rule-based, nên để ngắn. Đo thật 2,2-4,4s -> 8s là gấp đôi đầu.
#  - NLG giờ chỉ còn GREETING/REPROMPT (các câu khác render tất định) và hỏng thì
#    có câu mẫu thay ngay -> ngắn hơn nữa.
LLM_TIMEOUT_NLU=8
LLM_TIMEOUT_NLG=6
# --- Session store. Bỏ trống REDIS_URL -> in-memory (dev/MVP, Q5) ---
REDIS_URL=
SESSION_TTL_SECONDS=1800

# --- App-level encryption cho field vault trong session (Q5). Bỏ trống = không mã hóa
#     (chấp nhận ở MVP in-memory; bật khi lưu Redis/production — 7.1) ---
VAULT_ENC_KEY=

# Số chữa cháy khi chatbot CHƯA biết shop nào (khách chưa chọn, hoặc gọi /shops lỗi).
# Không dùng để thay số của một shop đã xác định.
FALLBACK_SHOP_PHONE=

SUPPORT_PHONE=

# --- Log ---
# DEBUG để soi đầy đủ request/response shop_api + LLM khi cần tìm nguyên nhân dữ liệu sai.
LOG_LEVEL=INFO

# --- FAQ / RAG (app/retrieval.py + app/answers/faq.py) ---
# Corpus. Bỏ trống DÒNG NÀY (để nguyên dấu #) là dùng mặc định: data/faq.md cạnh service,
# đường dẫn TUYỆT ĐỐI -> chạy service từ thư mục nào cũng thấy. Ghi FAQ_CORPUS_PATH= rỗng
# là TẮT hẳn làn FAQ.
#FAQ_CORPUS_PATH=

# Truy xuất là BM25 thuần stdlib, không có biến nào để chỉnh. Bot không nhận ra một cách
# hỏi nào thì thêm một dòng "> " vào mục tương ứng trong data/faq.md.

# Bước SINH (chữ G của RAG): chunk tìm được đi qua LLM diễn đạt lại cho khớp câu khách hỏi,
# thay vì đọc nguyên văn. Mặc định BẬT khi đã cấu hình LLM_BASE_URL; chưa có router thì tự
# tắt, không cần đụng cờ này. Đặt 0 để quay lại trả nguyên văn — dùng khi đang review nội
# dung faq.md và cần câu trả lời khớp từng chữ với file.
# LƯU Ý: bật là câu hỏi của khách THẬT SỰ bay sang router (trước đây truy xuất chạy nội bộ,
# không có gì rời hệ thống). Câu gửi đi đã mask PII (app/pii.py) và chunk không chứa PII,
# nhưng vẫn nên rà hợp đồng dữ liệu trước khi bật ở production.
FAQ_GENERATE=1

# Hạn chờ riêng cho bước sinh: nó chắn giữa câu hỏi và câu trả lời nên hỏng là khách ngồi
# đợi, mà bản nguyên văn luôn có sẵn để lùi về -> để ngắn như NLG.
LLM_TIMEOUT_FAQ=6

# --- Backend truy xuất ---
# bm25   = BM25 thuần stdlib, không cần cài gì (mặc định).
# hybrid = BM25 + vector (Chroma) hợp nhất bằng RRF, xếp lại bằng cross-encoder PhoRanker.
#          Cần: python -m pip install chromadb sentence-transformers pyvi  (~2-3GB)
#          Thiếu gói hoặc tải model hỏng -> tự lùi về bm25, ghi cảnh báo trong log.
# LƯU Ý: cả hai model chạy CỤC BỘ nên không có gì rời hệ thống — khác hẳn phương án gọi API
# embedding bên ngoài. Đổi lại: boot chậm ~10-30s và giữ ~1-1,5GB RAM.
RAG_BACKEND=bm25
EMBEDDING_MODEL=bkai-foundation-models/vietnamese-bi-encoder
RERANK_MODEL=itdainb/PhoRanker
# Mỗi nhánh lấy bao nhiêu ứng viên trước khi hợp nhất, và giữ lại bao nhiêu sau rerank.
# Rerank là cross-encoder: chi phí tỉ lệ THẲNG với RETRIEVE_TOP_K. Chậm thì giảm số này trước.
RETRIEVE_TOP_K=10
FINAL_TOP_K=3
# Rỗng -> data/faq_chroma/ cạnh service. Index chỉ dựng lại khi nội dung corpus đổi (băm hash).
VECTOR_STORE_PATH=
